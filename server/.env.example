NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/smarthire

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fill in with your own Groq API key to enable real AI resume screening
# (https://console.groq.com/keys)
GROQ_API_KEY=

# Fill these in with your own SMTP credentials to enable real email delivery
# (e.g. a Gmail app password, or a free Mailtrap/SendGrid sandbox). Without
# these, emails are logged to the console instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
